{
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "$checkpoint" } },
  "2": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["1", 1], "text": "$positive" } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["1", 1], "text": "$negative" } },
  "4": { "class_type": "EmptyLatentImage", "inputs": { "width": "$width", "height": "$height", "batch_size": 1 } },
  "8": { "class_type": "LoadImage", "inputs": { "image": "$ref_image" } },
  "9": { "class_type": "IPAdapterUnifiedLoader", "inputs": { "model": ["1", 0], "preset": "$ip_preset" } },
  "10": { "class_type": "IPAdapter", "inputs": { "model": ["9", 0], "ipadapter": ["9", 1], "image": ["8", 0], "weight": "$ip_weight", "start_at": 0.0, "end_at": "$ip_end", "weight_type": "standard" } },
  "5": { "class_type": "KSampler", "inputs": { "model": ["10", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0], "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "$sampler", "scheduler": "$scheduler", "denoise": 1.0 } },
  "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
  "7": { "class_type": "SaveAnimatedWEBP", "inputs": { "images": ["6", 0], "filename_prefix": "$prefix", "fps": 6.0, "lossless": false, "quality": "$quality", "method": "default" } }
}
