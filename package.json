{
  "name": "ash-and-fog",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node tools/smoke.js",
    "sim": "node tools/sim.js",
    "icons": "node tools/icons.js",
    "apk": "tools\\apk.cmd",
    "i18n": "node tools/i18n/check-shadow.mjs && node tools/i18n/extract.mjs && python tools/i18n/translate.py",
    "desktop": "vite build && electron .",
    "exe": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/rubik": "^5.3.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "main": "electron/main.cjs",
  "description": "Попіл і Туман — аніме-виживання в мертвому місті",
  "build": {
    "appId": "ua.darke.ashfog",
    "productName": "Попіл і Туман",
    "executableName": "AshAndFog",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/sw.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Попіл і Туман",
      "artifactName": "AshAndFog-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AshAndFog-Portable-${version}.${ext}"
    },
    "asar": true
  }
}
